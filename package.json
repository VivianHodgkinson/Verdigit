{
  "name": "sourcecontrol",
  "version": "0.2.5",
  "description": "Verdigit: a dark & green desktop Git client with Git Flow built in",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --publish never",
    "test": "esbuild test/backend.test.ts --bundle --platform=node --alias:@shared=./src/shared --sourcemap=inline --outfile=out/test/backend.test.js --log-level=warning && node --enable-source-maps out/test/backend.test.js",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never"
  },
  "author": "Vivian Hodgkinson <vivian@issuesoftware.co.za>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "productName": "Verdigit",
  "build": {
    "appId": "za.co.issuesoftware.sourcecontrol",
    "productName": "Verdigit",
    "executableName": "sourcecontrol",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "publish": {
      "provider": "github",
      "owner": "VivianHodgkinson",
      "repo": "Verdigit",
      "releaseType": "draft"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Verdigit",
      "artifactName": "${productName}-${version}-setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    },
    "linux": {
      "icon": "resources/icons",
      "category": "Development",
      "synopsis": "Git client with Git Flow built in",
      "description": "A dark & green desktop Git client with a commit graph, line staging, conflict resolution, interactive rebase and native Git Flow.",
      "maintainer": "Vivian Hodgkinson <vivian@issuesoftware.co.za>",
      "vendor": "Issue Software",
      "desktop": {
        "entry": {
          "Name": "Verdigit",
          "GenericName": "Git Client",
          "Keywords": "git;source;control;version;gitflow;"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "git",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2"
      ]
    },
    "rpm": {
      "depends": [
        "git",
        "xdg-utils",
        "libgtk-3.so.0()(64bit)",
        "libnss3.so()(64bit)",
        "libXss.so.1()(64bit)",
        "libXtst.so.6()(64bit)",
        "libatk-bridge-2.0.so.0()(64bit)",
        "libuuid.so.1()(64bit)",
        "libasound.so.2()(64bit)"
      ],
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "pacman": {
      "depends": [
        "git",
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libxtst",
        "xdg-utils",
        "at-spi2-core",
        "libsecret"
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.png"
    }
  },
  "homepage": "https://github.com/VivianHodgkinson/Verdigit",
  "repository": {
    "type": "git",
    "url": "https://github.com/VivianHodgkinson/Verdigit.git"
  },
  "desktopName": "sourcecontrol.desktop",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
